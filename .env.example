# Copy to .env.local and fill in. Never commit the filled in file.
#
# Keep these identical to the Vercel project settings. Local and production
# diverging is not a small annoyance: a single different digit in DATABASE_URL
# hid a production outage for days, because everything passed locally while the
# owner console failed every time in production. See DATABASE_URL below.

# Signs the portal session cookie. Generate with:  openssl rand -base64 32
# Changing it signs everybody out, which is the intended panic button.
PORTAL_AUTH_SECRET=

# Signs the short lived, site scoped tile grant that the Cloudflare Worker in
# workers/tile-gateway checks before serving anything from the private R2 bucket.
# Generate with:  openssl rand -base64 32
#
# MUST be a different value from PORTAL_AUTH_SECRET, and the code refuses to run
# if they match. This secret gets deployed to Cloudflare so the edge can verify
# grants; the session secret mints portal logins and must never leave our own
# infrastructure. Put the same value on the Worker with:
#   cd workers/tile-gateway && npx wrangler secret put PORTAL_TILE_SECRET
PORTAL_TILE_SECRET=

# Parent domain the tile grant cookie is scoped to, so it reaches the tile
# subdomain. In production this is ".sudaangeo.in" with the Worker on
# tiles.sudaangeo.in. Leave EMPTY in development: everything is on localhost, and
# a Domain attribute would stop the cookie being stored at all.
PORTAL_TILE_COOKIE_DOMAIN=

# Public base URL the map fetches tiles and COGs from, i.e. the Worker route.
# Leave empty to keep serving map data through the Next route as it does today.
NEXT_PUBLIC_TILE_BASE_URL=

# Supabase connection string, from Project settings -> Database -> Connection string.
#
# USE PORT 6543, THE TRANSACTION POOLER, EVERYWHERE.
#
# Supabase offers two ports and they behave differently under concurrency:
#   6543  transaction pooler  <- production, and what we use locally too
#   5432  session pooler
# Local ran on 5432 while Vercel ran on 6543, so no local test could reproduce
# what production was doing. Verified on 26 Jul 2026 that a long lived dev
# server is stable on 6543 across repeated loads and hot reloads, so there is no
# longer any reason to differ. The app warns at startup if this points at 5432.
#
# Do NOT use the direct connection (db.<ref>.supabase.co): it is IPv6 only on
# new projects and unreachable from many networks, including Vercel.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Google OAuth, from console.cloud.google.com -> Credentials.
# Authorised redirect URI must be <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Where the analysis reads a site's source rasters from. Two ways, and which one
# you need depends on whether there is a disk.
#
# PORTAL_TERRAIN_DIR is a directory holding <slug>/dtm.tif and <slug>/dsm.tif.
# Unset it and the default is ./portal-data/terrain, which is what a laptop uses
# and what the symlinks there point at. This is a LOCAL ONLY answer: those files
# are gitignored, they total over 300 MB, and a serverless deployment has a read
# only filesystem and a bundle limit around 250 MB, so no value of this variable
# works in production.
#
# PORTAL_TERRAIN_URL is the production answer. Point it at a base URL serving the
# same <slug>/<kind>.tif layout with HTTP Range support, and the analysis reads
# only the bytes covering the polygon that was drawn rather than the whole file.
# In practice that is the tile Worker in front of the private R2 bucket:
#
#   PORTAL_TERRAIN_URL=https://<worker>.workers.dev/sites
#
# The portal authorises itself to that Worker with the same short lived, site
# scoped grant a browser gets, minted server side, so the bucket stays private
# and there is one set of authorisation rules rather than two. Upload the rasters
# with the ordinary uploader, which puts them where the grant permits:
#
#   node scripts/upload-site.mjs --site <slug> --from <dir with dtm.tif, dsm.tif>
#
# Set both and the URL wins. Set neither and measurement is unavailable, which
# the map detects on load and reports rather than failing on the first click.
PORTAL_TERRAIN_DIR=
PORTAL_TERRAIN_URL=

# Cloudflare R2, read by scripts/upload-site.mjs to push a prepared site to the
# private bucket workers/tile-gateway serves. 10 GB free, and egress is free,
# which is the number that matters when serving imagery. From the Cloudflare
# dashboard under R2 -> Manage R2 API Tokens, scoped to the bucket named below.
#
# There is deliberately no Mapbox token here. The map is MapLibre, and basemaps
# are off by default because a tile request tells a third party where a client's
# site is. See context.md 8g.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sga-survey-data

# Where the site is reached. http://localhost:3000 locally, https://sudaangeo.in
# in production. Used to build the OAuth redirect, so a wrong value fails sign in.
AUTH_URL=http://localhost:3000

# Comma separated Google addresses that get owner access to the console.
# These bootstrap themselves on first sign in, so the first owner can get in
# against an empty database. Everyone else is granted access from the console.
PORTAL_OWNER_EMAILS=
